<UserControl x:Class="VoiceCalendar.Controls.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F2F7">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 月份导航 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="BtnPrev" Content="◀" Click="BtnPrev_Click"
                    Style="{StaticResource IosNavButton}" FontSize="14"
                    HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="TxtYear" Text="2026" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource IosDarkText}" Cursor="Hand"
                           MouseLeftButtonDown="TxtYear_Click"/>
                <TextBlock Text="年" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource IosDarkText}"/>
                <TextBlock x:Name="TxtMonth" Text="5月" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource IosDarkText}" Cursor="Hand" Margin="4,0,0,0"
                           MouseLeftButtonDown="TxtMonth_Click"/>
                <Button Content="今天" Click="BtnToday_Click" Margin="8,0,0,0"
                        Style="{StaticResource IosNavButton}" FontSize="12"
                        Foreground="{StaticResource IosBlue}" FontWeight="Normal"/>
            </StackPanel>
            <Button x:Name="BtnNext" Content="▶" Click="BtnNext_Click"
                    Style="{StaticResource IosNavButton}" FontSize="14"
                    HorizontalAlignment="Right"/>
        </Grid>

        <!-- 星期标题 -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="一" HorizontalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource IosGrayText}"/>
            <TextBlock Grid.Column="1" Text="二" HorizontalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource IosGrayText}"/>
            <TextBlock Grid.Column="2" Text="三" HorizontalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource IosGrayText}"/>
            <TextBlock Grid.Column="3" Text="四" HorizontalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource IosGrayText}"/>
            <TextBlock Grid.Column="4" Text="五" HorizontalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource IosGrayText}"/>
            <TextBlock Grid.Column="5" Text="六" HorizontalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource IosGrayText}"/>
            <TextBlock Grid.Column="6" Text="日" HorizontalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource IosGrayText}"/>
        </Grid>

        <!-- 日期网格容器 -->
        <Grid x:Name="DayGrid" Grid.Row="2"/>

        <!-- 年月选择器面板 -->
        <Grid x:Name="PickerPanel" Grid.Row="2" Visibility="Collapsed" Margin="4,4,4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 选择器标题栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Button Content="← 返回" Click="PickerBack_Click"
                        HorizontalAlignment="Left"
                        Style="{StaticResource IosNavButton}" FontSize="13"/>
                <TextBlock x:Name="TxtPickerTitle" Text="选择年份" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource IosDarkText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Content="取消" Click="PickerCancel_Click"
                        HorizontalAlignment="Right"
                        Style="{StaticResource IosNavButton}" FontSize="13"/>
            </Grid>

            <!-- 年份滚动列表 -->
            <ScrollViewer x:Name="YearScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <UniformGrid x:Name="YearGrid" Columns="3"/>
            </ScrollViewer>

            <!-- 月份网格 -->
            <UniformGrid x:Name="MonthGrid" Grid.Row="1" Columns="4" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>