<Window x:Class="VoiceCalendar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VoiceCalendar.Controls"
        xmlns:converters="clr-namespace:VoiceCalendar.Converters"
        Title="语音日历工具"
        Width="900" Height="680"
        MinWidth="780" MinHeight="560"
        Background="#F2F2F7"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部导航栏 ===== -->
        <Border Grid.Row="0" Background="White" Padding="16,12"
                BorderBrush="#E5E5EA" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 月份导航 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnPrevMonth" Content="◀"
                            Style="{StaticResource IosNavButton}" FontSize="14"
                            Click="BtnPrevMonth_Click"/>
                    <TextBlock x:Name="TxtMonthTitle" Text="2026年5月"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource IosDarkText}"
                               VerticalAlignment="Center" Margin="8,0"/>
                    <Button x:Name="BtnNextMonth" Content="▶"
                            Style="{StaticResource IosNavButton}" FontSize="14"
                            Click="BtnNextMonth_Click"/>
                </StackPanel>

                <!-- 右侧按钮 -->
                <Button Grid.Column="2" Content="今天"
                        Style="{StaticResource IosNavButton}" FontSize="15"
                        Click="BtnToday_Click" Margin="0,0,12,0"/>

                <Button Grid.Column="3" x:Name="BtnVoice"
                        Content="🎤 语音输入"
                        Style="{StaticResource IosPrimaryButton}"
                        Click="BtnVoice_Click" FontSize="14"/>
            </Grid>
        </Border>

        <!-- ===== 主体区域 ===== -->
        <Grid Grid.Row="1" Margin="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="340"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="280" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：日历控件 -->
            <Border Grid.Column="0" Background="White"
                    CornerRadius="12" Padding="4">
                <controls:CalendarView x:Name="CalendarView"/>
            </Border>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1" Width="4"
                          Background="Transparent"
                          HorizontalAlignment="Stretch"/>

            <!-- 右侧：事件面板 -->
            <Border Grid.Column="2" Background="White"
                    CornerRadius="12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 选中日期标题 -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="TxtSelectedDate"
                                   Text="5月30日"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource IosDarkText}"/>
                        <TextBlock x:Name="TxtSelectedWeekday"
                                   Text="周六"
                                   FontSize="14"
                                   Foreground="{StaticResource IosGrayText}"/>
                    </StackPanel>

                    <Border Grid.Row="1" Height="1" Background="#E5E5EA" Margin="0,0,0,8"/>

                    <!-- 事件列表 -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="EventList" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8F8FB"
                                            CornerRadius="8"
                                            Padding="10,8" Margin="0,0,0,6">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="编辑" Click="MenuItemEdit_Click"/>
                                                <MenuItem Header="删除" Click="MenuItemDelete_Click"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 左侧蓝色指示条 -->
                                            <Border Grid.Column="0"
                                                    Width="3" CornerRadius="2"
                                                    Background="#007AFF"
                                                    VerticalAlignment="Stretch"
                                                    Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="#1C1C1E"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding TimeDisplay}"
                                                           FontSize="12"
                                                           Foreground="#8E8E93" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 添加事件按钮 -->
                    <Button Grid.Row="3" Content="+ 添加事件"
                            Style="{StaticResource IosPrimaryButton}"
                            Click="BtnAddEvent_Click"
                            HorizontalAlignment="Stretch"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 底部状态栏 ===== -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="#E5E5EA" BorderThickness="0,1,0,0"
                Padding="16,8">
            <TextBlock x:Name="TxtStatus" Text="就绪"
                       FontSize="12" Foreground="{StaticResource IosGrayText}"/>
        </Border>
    </Grid>
</Window>