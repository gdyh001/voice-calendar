<Window x:Class="VoiceCalendar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VoiceCalendar.Controls"
        xmlns:converters="clr-namespace:VoiceCalendar.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="G Day" Width="960" Height="700"
        MinWidth="800" MinHeight="580"
        Background="#F2F2F7"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0"
                            ResizeBorderThickness="5"
                            CaptionHeight="44"
                            CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DayToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="Background" Value="#F2F2F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="18">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#007AFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="#E5E5EA"/>
                            </MultiTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0055CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 标题栏 ===== -->
        <Border Grid.Row="0" Height="44" Background="#007AFF" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="G Day" FontSize="16" FontWeight="Bold" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                           Foreground="White" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Style="{StaticResource WinBtn}" Click="BtnMinimize_Click"/>
                    <Button x:Name="BtnMaximize" Content="□" Style="{StaticResource WinBtn}" Click="BtnMaximize_Click"/>
                    <Button Content="✕" Style="{StaticResource WinBtn}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 主体 ===== -->
        <Grid Grid.Row="1" Margin="12,4,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="280" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- 日历 -->
            <Border Grid.Column="0" Background="White" CornerRadius="0,0,0,12" Padding="4">
                <controls:CalendarView x:Name="CalendarView"/>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="Transparent"/>

            <!-- 右侧面板：日程视图 -->
            <Border Grid.Column="2" Background="White" CornerRadius="0,0,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                    <!-- 新建日程表单 -->
                    <ScrollViewer x:Name="FormPanel" Grid.Row="0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <TextBlock x:Name="FormTitle" Text="新建日程" FontSize="18" FontWeight="Bold"
                                       Foreground="#1C1C1E" Margin="0,0,0,16"/>

                            <TextBlock Text="日程名称" FontSize="12" FontWeight="SemiBold" Foreground="#8E8E93" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtEventTitle" FontSize="14" Padding="10,8"
                                     BorderBrush="#E5E5EA" BorderThickness="1" Margin="0,0,0,12"/>

                            <TextBlock Text="日程备注" FontSize="12" FontWeight="SemiBold" Foreground="#8E8E93" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtEventNote" FontSize="14" Padding="10,8"
                                     BorderBrush="#E5E5EA" BorderThickness="1" TextWrapping="Wrap"
                                     AcceptsReturn="True" Height="56" Margin="0,0,0,12"/>

                            <!-- iOS 风格时间选择器 -->
                            <Border x:Name="StartRow" Background="Transparent" CornerRadius="8"
                                    Padding="12,10" Cursor="Hand"
                                    MouseLeftButtonDown="StartRow_Click"
                                    BorderBrush="#E5E5EA" BorderThickness="1" Margin="0,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="开始" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#1C1C1E" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtStartDisplay" Grid.Column="1" Text="5月31日 上午4:00"
                                               FontSize="13" Foreground="#007AFF" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text=">" FontSize="14" Foreground="#C7C7CC"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <Border Height="1" Background="#E5E5EA" Margin="12,0"/>

                            <Border x:Name="EndRow" Background="Transparent" CornerRadius="8"
                                    Padding="12,10" Cursor="Hand"
                                    MouseLeftButtonDown="EndRow_Click"
                                    BorderBrush="#E5E5EA" BorderThickness="1" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="结束" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#1C1C1E" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtEndDisplay" Grid.Column="1" Text="5月31日 上午5:00"
                                               FontSize="13" Foreground="#007AFF" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text=">" FontSize="14" Foreground="#C7C7CC"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- 每周重复 -->
                            <StackPanel x:Name="RecurringSection" Margin="0,4,0,8">
                                <ToggleButton x:Name="ToggleRecurring" Content="🔄 每周重复"
                                    FontSize="13" FontWeight="SemiBold" Foreground="#007AFF"
                                    Background="Transparent" BorderBrush="#007AFF" BorderThickness="1"
                                    Padding="12,6" Cursor="Hand" HorizontalAlignment="Left"
                                    Click="ToggleRecurring_Click">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#EBF5FF"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#007AFF"/>
                                                    <Setter Property="Foreground" Value="#007AFF"/>
                                                    <Setter Property="Content" Value="取消重复"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter Property="Content" Value="🔄 每周重复"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <WrapPanel x:Name="DayOfWeekPanel"
                                            Visibility="Collapsed" Margin="0,6,0,0">
                                    <ToggleButton x:Name="DayMon" Content="一" Style="{StaticResource DayToggle}" Click="DayToggle_Click" Tag="0"/>
                                    <ToggleButton x:Name="DayTue" Content="二" Style="{StaticResource DayToggle}" Click="DayToggle_Click" Tag="1"/>
                                    <ToggleButton x:Name="DayWed" Content="三" Style="{StaticResource DayToggle}" Click="DayToggle_Click" Tag="2"/>
                                    <ToggleButton x:Name="DayThu" Content="四" Style="{StaticResource DayToggle}" Click="DayToggle_Click" Tag="3"/>
                                    <ToggleButton x:Name="DayFri" Content="五" Style="{StaticResource DayToggle}" Click="DayToggle_Click" Tag="4"/>
                                    <ToggleButton x:Name="DaySat" Content="六" Style="{StaticResource DayToggle}" Click="DayToggle_Click" Tag="5"/>
                                    <ToggleButton x:Name="DaySun" Content="日" Style="{StaticResource DayToggle}" Click="DayToggle_Click" Tag="6"/>
                                </WrapPanel>
                            </StackPanel>

                            <!-- 三列滚轮时间选择器 -->
                            <Border x:Name="TimePickerPanel" Background="#F8F8FB" CornerRadius="10"
                                    Padding="8,6" Margin="0,0,0,8" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbAmPm" Grid.Column="0" FontSize="16" PreviewMouseWheel="TimePicker_MouseWheel"
                                              SelectionChanged="TimePicker_SelectionChanged" Margin="4,0">
                                        <ComboBoxItem Content="上午"/>
                                        <ComboBoxItem Content="下午"/>
                                    </ComboBox>
                                    <ComboBox x:Name="CmbHour" Grid.Column="1" FontSize="16" PreviewMouseWheel="TimePicker_MouseWheel"
                                              SelectionChanged="TimePicker_SelectionChanged" Margin="4,0">
                                        <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/>
                                        <ComboBoxItem Content="3"/><ComboBoxItem Content="4"/>
                                        <ComboBoxItem Content="5"/><ComboBoxItem Content="6"/>
                                        <ComboBoxItem Content="7"/><ComboBoxItem Content="8"/>
                                        <ComboBoxItem Content="9"/><ComboBoxItem Content="10"/>
                                        <ComboBoxItem Content="11"/><ComboBoxItem Content="12"/>
                                    </ComboBox>
                                    <ComboBox x:Name="CmbMinute" Grid.Column="2" FontSize="16" PreviewMouseWheel="TimePicker_MouseWheel"
                                              SelectionChanged="TimePicker_SelectionChanged" Margin="4,0">
                                        <ComboBoxItem Content="00"/><ComboBoxItem Content="05"/>
                                        <ComboBoxItem Content="10"/><ComboBoxItem Content="15"/>
                                        <ComboBoxItem Content="20"/><ComboBoxItem Content="25"/>
                                        <ComboBoxItem Content="30"/><ComboBoxItem Content="35"/>
                                        <ComboBoxItem Content="40"/><ComboBoxItem Content="45"/>
                                        <ComboBoxItem Content="50"/><ComboBoxItem Content="55"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- 隐藏的 DatePicker 用于日期选择 -->
                            <DatePicker x:Name="HiddenDatePicker" Visibility="Collapsed"
                                        SelectedDateChanged="HiddenDatePicker_DateChanged"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 日程区域 -->
                    <Grid x:Name="SchedulePanel" Grid.Row="0"><!-- 日期标题 + 日程列表 -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F8F8FB" CornerRadius="10" Padding="12,16" Margin="12,12,12,8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtScheduleDate" Text="5月30日" FontSize="20" FontWeight="Bold"
                                           Foreground="#1C1C1E" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtScheduleWeekday" Text="周六" FontSize="13"
                                           Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,0,12,0">
                            <Grid>
                                <TextBlock x:Name="TxtEmptySchedule" Text="暂无日程" FontSize="14"
                                           Foreground="#8E8E93" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Visible"/>
                                <ItemsControl x:Name="ScheduleList" Visibility="Collapsed">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8F8FB" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="3" CornerRadius="2"
                                                            Background="#007AFF" VerticalAlignment="Stretch" Margin="0,0,10,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding TimeDisplay}" FontSize="13"
                                                                   Foreground="#007AFF" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                                        <TextBlock Text="{Binding Title}" FontSize="14" Margin="0,0,4,0"
                                                                   Foreground="#1C1C1E" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding EndTimeDisplay}" FontSize="13"
                                                                   Foreground="#007AFF" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding RecurrenceDisplay}" FontSize="11"
                                                                   Foreground="#007AFF" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Opacity" Value="0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource FindAncestor, AncestorType=Border}}" Value="True">
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Button Content="✎" Click="BtnEditInline_Click" Foreground="#007AFF"
                                                                Background="Transparent" BorderThickness="0" FontSize="16"
                                                                Cursor="Hand" Padding="4,2" ToolTip="编辑"/>
                                                        <Button Content="✕" Click="BtnDeleteInline_Click" Foreground="#FF3B30"
                                                                Background="Transparent" BorderThickness="0" FontSize="16"
                                                                Cursor="Hand" Padding="4,2" ToolTip="删除"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                                        </Grid>

                    <!-- 实时识别文字 -->
                    <TextBlock Grid.Row="1" x:Name="TxtLiveText"
                               Text="..." FontSize="14" Foreground="#8E8E93"
                               Padding="12,8,12,4" Visibility="Collapsed"
                               TextWrapping="Wrap"/>

                    <!-- 底部双按钮 -->
                    <Border Grid.Row="2" Background="White" Padding="12,8,12,12"
                            BorderBrush="#E5E5EA" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="BtnVoiceIdle"
                                    Click="BtnVoice_Click" Height="40" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="#F0F6FF" CornerRadius="10"
                                                BorderBrush="#007AFF" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🎤" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="语音添加" FontSize="13" Foreground="#007AFF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#D6E9FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="0" x:Name="BtnVoiceRecording"
                                    Click="BtnVoice_Click" Height="40" Cursor="Hand"
                                    Visibility="Collapsed">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="#007AFF" CornerRadius="10">
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="⏺" FontSize="14" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="RecordingLabel" Text="结束录制" FontSize="13" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#0055CC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 日程模式：+新建 -->
                            <Button Grid.Column="2" x:Name="BtnNewFromSchedule"
                                    Click="BtnNewFromSchedule_Click" Height="40" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="#007AFF" CornerRadius="10">
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="+" FontSize="18" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="新建" FontSize="13" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#0055CC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 表单模式：取消 + 保存 -->
                            <Grid Grid.Column="2" x:Name="FormButtons" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnCancelForm"
                                        Click="BtnCancelForm_Click" Height="40" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="#F2F2F7" CornerRadius="10">
                                                <TextBlock Text="取消" FontSize="13" Foreground="#8E8E93" VerticalAlignment="Center"
                                                           FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            </Border>
                                        
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#E5E5EA"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Grid.Column="2" x:Name="BtnSaveForm"
                                        Click="BtnSaveForm_Click" Height="40" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="#007AFF" CornerRadius="10">
                                                <TextBlock Text="保存" FontSize="13" Foreground="White" VerticalAlignment="Center"
                                                           FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            </Border>
                                        
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#0055CC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>


        <!-- 删除确认遮罩 -->
        <Grid x:Name="DeleteConfirmOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 半透明背景 -->
            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3"
                    Background="#66000000" MouseLeftButtonDown="BtnDeleteConfirmCancel_Click"/>

            <!-- 确认卡片 -->
            <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="14"
                    Width="320" Padding="24,20">
                <StackPanel>
                    <TextBlock Text="确认删除" FontSize="17" FontWeight="Bold"
                               Foreground="#1C1C1E" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock x:Name="TxtDeleteConfirmMsg" Text="确定删除此日程?"
                               FontSize="14" Foreground="#8E8E93"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="BtnDeleteConfirmCancel"
                                Click="BtnDeleteConfirmCancel_Click" Height="40" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#F2F2F7" CornerRadius="10">
                                        <TextBlock Text="取消" FontSize="13" Foreground="#8E8E93" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#E5E5EA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="2" x:Name="BtnDeleteConfirmOk"
                                Click="BtnDeleteConfirmOk_Click" Height="40" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#FF3B30" CornerRadius="10">
                                        <TextBlock Text="删除" FontSize="13" Foreground="White"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#D63029"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
